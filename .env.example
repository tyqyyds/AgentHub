# ============================================================
# AgentHub 环境变量模板
# 复制此文件为 .env 并填入实际值
# 警告：.env 文件包含敏感信息，绝不可提交到版本控制！
# ============================================================

# Application Settings
APP_NAME=NetOps_Intent_System
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# PostgreSQL Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agenthub
POSTGRES_USER=agenthub_app
# [必须] 设置强密码，至少16位，包含大小写字母、数字和特殊字符
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# InfluxDB Settings
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=<YOUR_INFLUXDB_TOKEN>
INFLUXDB_ORG=netops
INFLUXDB_BUCKET=telemetry

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# [必须] Redis 密码认证，docker-compose 启动时强制要求
# 生成方式: openssl rand -base64 32
REDIS_PASSWORD=<CHANGE_ME_REDIS_PASSWORD>

# LLM Settings
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
OPENAI_MODEL=gpt-4-turbo-preview
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=30

# DeepSeek Settings
DEEPSEEK_API_KEY=<YOUR_DEEPSEEK_API_KEY>
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# ZhiPu (智谱) Settings
ZHIPU_API_KEY=<YOUR_ZHIPU_API_KEY>
ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
ZHIPU_MODEL=glm-4-flash

# LLM Gateway Settings
LLM_PROVIDER_PRIORITY=zhipu,deepseek

# Security Settings
# [必须] 应用密钥，用于 JWT 签名等，至少32位随机字符串
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<GENERATE_A_STRONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS>
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=60
