# Application Settings
APP_NAME=NetOps_Intent_System
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# PostgreSQL Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=netops_db
POSTGRES_USER=netops_user
POSTGRES_PASSWORD=netops_password

# InfluxDB Settings
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=netops_admin_token
INFLUXDB_ORG=netops
INFLUXDB_BUCKET=telemetry

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# LLM Settings
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4-turbo-preview
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=30

# Security Settings
SECRET_KEY=your_secret_key_here_must_be_at_least_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=60
MAX_REQUESTS_PER_HOUR=500

# Network Timeout
DEVICE_CONNECT_TIMEOUT=10
DEVICE_READ_TIMEOUT=30

# Change Window Settings
CHANGE_WINDOW_START=08:00
CHANGE_WINDOW_END=22:00